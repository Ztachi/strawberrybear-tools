{
  "name": "@strawberrybear/infinity-nikki-player",
  "private": true,
  "version": "1.1.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint .",
    "clean": "rimraf src-tauri/target",
    "tauri": "tauri",
    "tauri:dev": "pnpm clean && pnpm tauri dev",
    "tauri:build:exe": "node scripts/tauri-build-with-mirror.mjs --no-bundle",
    "tauri:build:msi": "node scripts/tauri-build-with-mirror.mjs --bundles msi",
    "tauri:build:nsis": "node scripts/tauri-build-with-mirror.mjs --bundles nsis",
    "nikki": "bash scripts/build-and-launch.sh"
  },
  "dependencies": {
    "@antdv-next/icons": "^1.0.8",
    "@strawberrybear/keystroke-sequencer": "workspace:*",
    "@strawberrybear/piano-roll": "workspace:*",
    "@strawberrybear/player": "workspace:*",
    "@tanstack/vue-virtual": "^3.13.28",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@tonejs/piano": "^0.2.1",
    "@vueuse/core": "^14.2.1",
    "antdv-next": "1.3.3",
    "cropperjs": "^2.1.1",
    "events": "^3.3.0",
    "lodash-es": "^4.18.1",
    "lucide-vue-next": "^0.469.0",
    "midi-player-js": "^2.0.17",
    "pinia": "^3.0.1",
    "soundfont-player": "^0.12.0",
    "tone": "^14.9.17",
    "vue": "^3.5.13",
    "vue-i18n": "^10.0.5",
    "vue-router": "^4.6.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "@types/node": "^22.19.17",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "rimraf": "^6.1.3",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.7.2",
    "vite": "^8.0.5",
    "vue-tsc": "^2.2.0"
  }
}
