{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "InfinityNikkiPlayer",
  "version": "0.3.2",
  "identifier": "com.strawberrybear.infinity-nikki-player",
  "build": {
    "devUrl": "http://localhost:1421",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "无限暖暖自动演奏",
        "width": 980,
        "height": 640,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 10, "y": 25 },
        "visible": true,
        "transparent": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "targets": ["dmg", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "resources": ["en.lproj", "zh-Hans.lproj", "templates", "midi"],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZBMDY0QUI1N0EyNDZBODMKUldTRGFpUjZ0VW9HYXBCNklibGJ3WVp3SmpWU21MbHVQTDNXZDk3UURQRkhZVUVkUVRqTWJzdmUK",
      "endpoints": [
        "https://github.com/Ztachi/strawberrybear-tools/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
